# OpenAI-compatible provider. Keep real credentials only in a local .env file.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: without this key all originals are saved; no fake AI summary is generated.
OPENAI_API_KEY=

# Keep model choices centralized here. Change these without editing application code.
OPENAI_MODEL_SIMPLE=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_REPORT=gpt-4o-mini
OPENAI_MODEL_LONG=gpt-4o

# API mode: auto uses Responses; compatibility fallback only on explicit rejection.
OPENAI_API_MODE=auto
OPENAI_USER_AGENT=PersonalJournal/0.1
# AI runs in the background. Long notes can take more than a minute.
OPENAI_RESPONSES_TIMEOUT_SECONDS=150
OPENAI_CHAT_TIMEOUT_SECONDS=150
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=6000

# Local runtime settings
# 0.0.0.0 allows another device on the same Wi-Fi to open the app.
JOURNAL_HOST=0.0.0.0
JOURNAL_PORT=8765
JOURNAL_DB_PATH=./data/journal.sqlite3
# Optional installed system voice used for local narration.
JOURNAL_TTS_WARM_VOICE=
# Set true only when served behind HTTPS.
JOURNAL_COOKIE_SECURE=false
